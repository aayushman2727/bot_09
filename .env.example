# bot_09 Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to source control.

# ── Authentication ────────────────────────────────────────────────────────────
# Personal Access Token or fine-grained token with "Contents: Write" scope.
# Required only when using --push locally (GitHub Actions uses its own token).
GITHUB_TOKEN=

# ── Optional overrides ────────────────────────────────────────────────────────
# Absolute path to the repository (defaults to the project root)
# REPO_PATH=

# Default number of commits per run (default: 1)
# COMMIT_COUNT=1

# Default activity file name (default: activity.json)
# ACTIVITY_FILE=activity.json

# Set to 'true' to push by default without --push flag
# PUSH=false
